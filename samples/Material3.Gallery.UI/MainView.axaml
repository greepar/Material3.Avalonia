                </m3c:FloatingActionButton>
              </m3c:BottomAppBar.FloatingActionButton>
            </m3c:BottomAppBar>

            <TextBlock Classes="title-small" Text="BottomSheet" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <StackPanel Spacing="8" Width="480" HorizontalAlignment="Left">
              <Button Classes="tonal" Content="Open bottom sheet" Click="OnOpenBottomSheet" />
              <Border Height="300" ClipToBounds="True"
                      BorderBrush="{DynamicResource Md3OutlineVariantBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Md3CornerMedium}">
                <Panel>
                  <TextBlock Margin="16" Text="Host panel content behind the sheet."
                             Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
                  <m3c:BottomSheet Name="SheetDemo">
                    <StackPanel Margin="24,8,24,24" Spacing="8">
                      <TextBlock Classes="title-medium" Text="Bottom sheet" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
                      <TextBlock Text="Sheets show secondary content anchored to the bottom." Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
                      <TextBlock Text="Tap the scrim to dismiss." Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
                    </StackPanel>
                  </m3c:BottomSheet>
                </Panel>
              </Border>
            </StackPanel>

            <TextBlock Classes="title-small" Text="SnackbarHost" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <m3c:SnackbarHost Name="SnackbarHostDemo" Width="480" Height="160" HorizontalAlignment="Left">
              <Border BorderBrush="{DynamicResource Md3OutlineVariantBrush}" BorderThickness="1"
                      CornerRadius="{StaticResource Md3CornerMedium}">
                <Button Classes="tonal" Content="Show snackbar" Click="OnShowSnackbar"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </m3c:SnackbarHost>
          </StackPanel>

          <!-- ======================= Loading & progress ======================= -->
          <StackPanel Name="LoadingSection" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left" IsVisible="False">
            <TextBlock Classes="display-small page-title" Text="Loading &amp; progress" Foreground="{DynamicResource Md3OnSurfaceBrush}" />

            <TextBlock Classes="title-small" Text="LoadingIndicator (M3 Expressive)" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
              <m3c:LoadingIndicator />
              <m3c:LoadingIndicator />
              <m3c:LoadingIndicator />
              <m3c:LoadingIndicator Variant="Contained" />
            </StackPanel>
            <TextBlock Classes="body-medium" Text="Shape-morphing M3 Expressive loading indicator"
                       Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />

            <TextBlock Classes="title-small" Text="CircularProgressIndicator (plain / wavy)" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
              <m3c:CircularProgressIndicator Minimum="0" Maximum="100" Value="65" />
              <m3c:CircularProgressIndicator IsIndeterminate="True" />
              <m3c:CircularProgressIndicator IsWavy="True" Minimum="0" Maximum="100" Value="70" />
              <m3c:CircularProgressIndicator IsWavy="True" IsIndeterminate="True" />
            </StackPanel>

            <TextBlock Classes="title-small" Text="WavyProgressBar (M3 Expressive)" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <StackPanel Spacing="16" Width="360" HorizontalAlignment="Left">
              <m3c:WavyProgressBar Minimum="0" Maximum="100" Value="60" />
              <m3c:WavyProgressBar IsIndeterminate="True" />
            </StackPanel>

            <TextBlock Classes="title-small" Text="ProgressBar" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <StackPanel Spacing="16" Width="360" HorizontalAlignment="Left">
              <ProgressBar Minimum="0" Maximum="100" Value="60" />
              <ProgressBar IsIndeterminate="True" />
            </StackPanel>
          </StackPanel>

          <!-- ======================= Button groups ======================= -->
          <StackPanel Name="GroupsSection" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left" IsVisible="False">
            <TextBlock Classes="display-small page-title" Text="Button groups" Foreground="{DynamicResource Md3OnSurfaceBrush}" />

            <TextBlock Classes="title-small" Text="ButtonGroup (Standard)" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <m3c:ButtonGroup Variant="Standard" HorizontalAlignment="Left">
              <Button Content="One" />
              <Button Content="Two" />
              <Button Content="Three" />
            </m3c:ButtonGroup>
            <TextBlock Classes="body-medium" Text="Press and hold to see neighbors squeeze"
                       Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />

            <TextBlock Classes="title-small" Text="ButtonGroup (Connected)" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <m3c:ButtonGroup Variant="Connected" HorizontalAlignment="Left">
              <Button Content="One" />
              <Button Content="Two" />
              <Button Content="Three" />
            </m3c:ButtonGroup>

            <TextBlock Classes="title-small" Text="SegmentedButtonGroup (Single)" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <m3c:SegmentedButtonGroup SelectionMode="Single" HorizontalAlignment="Left">
              <m3c:SegmentedButton Content="Day" IsChecked="True" />
              <m3c:SegmentedButton Content="Week" />
              <m3c:SegmentedButton Content="Month" />
            </m3c:SegmentedButtonGroup>

            <TextBlock Classes="title-small" Text="SegmentedButtonGroup (Multiple)" Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            <m3c:SegmentedButtonGroup SelectionMode="Multiple" HorizontalAlignment="Left">
              <m3c:SegmentedButton Content="Bold" IsChecked="True" />
              <m3c:SegmentedButton Content="Italic" />
              <m3c:SegmentedButton Content="Underline" IsChecked="True" />
            </m3c:SegmentedButtonGroup>
          </StackPanel>

          <!-- ======================= Typography ======================= -->
          <StackPanel Name="TypographySection" Spacing="8" MaxWidth="1000" HorizontalAlignment="Left" IsVisible="False">
            <TextBlock Classes="display-small page-title" Text="Typography" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="display-large" Text="Display Large" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="display-medium" Text="Display Medium" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="display-small" Text="Display Small" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="headline-large" Text="Headline Large" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="headline-medium" Text="Headline Medium" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="headline-small" Text="Headline Small" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="title-large" Text="Title Large" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="title-medium" Text="Title Medium" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="title-small" Text="Title Small" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="body-large" Text="Body Large — The quick brown fox jumps over the lazy dog." Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="body-medium" Text="Body Medium — The quick brown fox jumps over the lazy dog." Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="body-small" Text="Body Small — The quick brown fox jumps over the lazy dog." Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="label-large" Text="Label Large" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="label-medium" Text="Label Medium" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="label-small" Text="Label Small" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
          </StackPanel>

          <!-- ======================= Colors ======================= -->
          <StackPanel Name="ColorsSection" Spacing="16" MaxWidth="1000" HorizontalAlignment="Left" IsVisible="False">
            <TextBlock Classes="display-small page-title" Text="Color roles" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <WrapPanel Name="ColorsPanel" ItemSpacing="8" LineSpacing="8" />
          </StackPanel>

          <!-- ======================= Material Symbols ======================= -->
          <Grid Name="IconsSection" RowDefinitions="Auto,Auto,Auto" RowSpacing="16"
                MaxWidth="1200" HorizontalAlignment="Stretch" IsVisible="False">
            <StackPanel Grid.Row="0" Spacing="4">
              <TextBlock Classes="display-small page-title" Text="Material Symbols" Foreground="{DynamicResource Md3OnSurfaceBrush}" />
              <TextBlock Classes="body-medium"
                         Text="4,007 Rounded 400 icons, optically sized for 24dp. ItemsRepeater realizes only cards inside the current viewport."
                         Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBox Name="IconSearchBox" PlaceholderText="Search icons or C# property names"
                       TextChanged="OnIconSearchChanged" />
              <ComboBox Grid.Column="1" Name="IconVariantCombo" Width="132"
                        SelectionChanged="OnIconVariantChanged">
                <ComboBoxItem Content="Regular" />
                <ComboBoxItem Content="Filled" />
              </ComboBox>
            </Grid>

            <StackPanel Grid.Row="2" Spacing="12">
              <TextBlock Name="IconCountText" Classes="label-large"
                         Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
              <ItemsRepeater Name="IconRepeater">
                <ItemsRepeater.Layout>
                  <UniformGridLayout Orientation="Horizontal"
                                     MinItemWidth="164" MinItemHeight="132"
                                     MinColumnSpacing="12" MinRowSpacing="12"
                                     ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                  <DataTemplate x:DataType="local:MaterialSymbolGalleryItem">
                    <Border Padding="12" MinHeight="132"
                            Background="{DynamicResource Md3SurfaceContainerLowBrush}"
                            CornerRadius="{StaticResource Md3CornerMedium}">
                      <Grid RowDefinitions="*,Auto,Auto" RowSpacing="6">
                        <PathIcon HorizontalAlignment="Center"
                                  Foreground="{DynamicResource Md3OnSurfaceBrush}"
                                  Data="{Binding Geometry}" />
                        <TextBlock Grid.Row="1" Text="{Binding Name}"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Md3OnSurfaceBrush}" />
                        <Button Grid.Row="2" Classes="text" Padding="4,2"
                                HorizontalContentAlignment="Center"
                                Tag="{Binding ApiName}" Click="OnCopyIconNameClick">
                          <TextBlock Text="{Binding ApiName}" FontSize="10"
                                     TextTrimming="CharacterEllipsis" />
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsRepeater.ItemTemplate>
              </ItemsRepeater>
            </StackPanel>
          </Grid>

          </Panel>
        </ScrollViewer>
      </Border>
    </SplitView>
  </Grid>
</UserControl>
