<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:Material3.Avalonia.Icons"
        x:Class="Material3.Gallery.UI.TrayPanelWindow"
        Width="340" Height="390"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowDecorations="None"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent">
  <Border Margin="14" Padding="24"
          Background="{DynamicResource Md3SurfaceContainerBrush}"
          CornerRadius="28"
          BoxShadow="{StaticResource Md3Elevation3}">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="20">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3">
          <TextBlock Classes="title-large" Text="Material 3 Gallery"
                     Foreground="{DynamicResource Md3OnSurfaceBrush}" />
          <TextBlock Classes="body-small" Text="Running in the background"
                     Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Classes="text" Width="40" Height="40" Padding="8"
                Click="OnHideClick">
          <PathIcon Data="{x:Static icons:MaterialSymbols.Close}" />
        </Button>
      </Grid>

      <Border Grid.Row="1" Padding="16,12"
              Background="{DynamicResource Md3SecondaryContainerBrush}"
              CornerRadius="16">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
          <Ellipse Width="10" Height="10" Fill="#2E7D32" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Spacing="2">
            <TextBlock Classes="label-large" Text="Gallery is ready"
                       Foreground="{DynamicResource Md3OnSecondaryContainerBrush}" />
            <TextBlock Classes="body-small" Text="Theme and component previews stay available."
                       Foreground="{DynamicResource Md3OnSecondaryContainerBrush}" />
          </StackPanel>
          <PathIcon Grid.Column="2" Data="{x:Static icons:MaterialSymbols.CheckCircle}"
                    Foreground="{DynamicResource Md3OnSecondaryContainerBrush}" />
        </Grid>
      </Border>

      <Button Grid.Row="2" HorizontalAlignment="Stretch" Click="OnShowGalleryClick">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Data="{x:Static icons:MaterialSymbols.OpenInNew}" />
          <TextBlock Text="Show gallery" VerticalAlignment="Center" />
        </StackPanel>
      </Button>

      <Border Grid.Row="3" Padding="4,0" Background="Transparent">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2" VerticalAlignment="Center">
            <TextBlock Classes="label-large" Text="Dark theme"
                       Foreground="{DynamicResource Md3OnSurfaceBrush}" />
            <TextBlock Classes="body-small" Text="Switch the whole gallery theme"
                       Foreground="{DynamicResource Md3OnSurfaceVariantBrush}" />
          </StackPanel>
          <ToggleSwitch Grid.Column="1" Name="DarkThemeSwitch"
                        VerticalAlignment="Center"
                        OnContent="" OffContent="" />
        </Grid>
      </Border>

      <Button Grid.Row="4" Classes="outlined danger" HorizontalAlignment="Stretch"
              VerticalAlignment="Bottom" Click="OnQuitClick">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Data="{x:Static icons:MaterialSymbols.PowerSettingsNew}" />
          <TextBlock Text="Quit application" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>
  </Border>
</Window>
