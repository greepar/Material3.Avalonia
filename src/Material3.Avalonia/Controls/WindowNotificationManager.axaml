<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:DataType="WindowNotificationManager">

  <!-- Material 3 notification manager. Template contract: PART_Items (ReversibleStackPanel).
       Position pseudo-classes: :topleft :topright :topcenter :bottomleft :bottomright :bottomcenter. -->
  <ControlTheme x:Key="{x:Type WindowNotificationManager}" TargetType="WindowNotificationManager">
    <Setter Property="Margin" Value="0 0" />
    <Setter Property="Template">
      <ControlTemplate>
        <ReversibleStackPanel Name="PART_Items">
          <ReversibleStackPanel.DataTemplates>
            <DataTemplate DataType="INotification">
              <StackPanel Margin="16,12"
                          Spacing="4"
                          TextElement.Foreground="{DynamicResource Md3OnSurfaceBrush}">
                <TextBlock FontWeight="Medium"
                           FontSize="{StaticResource Md3TitleSmallSize}"
                           FontFamily="{DynamicResource Md3FontFamilyPlain}"
                           Text="{Binding Title}" />
                <TextBlock MaxHeight="80"
                           Margin="0,0,12,0"
                           FontSize="{StaticResource Md3BodyMediumSize}"
                           FontFamily="{DynamicResource Md3FontFamilyPlain}"
                           Foreground="{DynamicResource Md3OnSurfaceVariantBrush}"
                           Text="{Binding Message}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="x:String">
              <TextBlock Margin="16,12"
                         FontSize="{StaticResource Md3BodyMediumSize}"
                         FontFamily="{DynamicResource Md3FontFamilyPlain}"
                         Foreground="{DynamicResource Md3OnSurfaceBrush}"
                         Text="{Binding}" />
            </DataTemplate>
          </ReversibleStackPanel.DataTemplates>
        </ReversibleStackPanel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:topleft /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="^:topright /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="^:topcenter /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="^:bottomleft /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style Selector="^:bottomright /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <Style Selector="^:bottomcenter /template/ ReversibleStackPanel#PART_Items">
      <Setter Property="ReverseOrder" Value="True" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
