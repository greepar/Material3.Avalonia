<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Material 3 TableViewCell (per Avalonia 12.1.0 TableViewCell.cs: plain ContentControl,
       no template parts). M3 data table cell: 12px horizontal padding, body-medium (14). -->

  <Thickness x:Key="Md3TableViewCellPadding">12,0</Thickness>

  <ControlTheme x:Key="{x:Type TableViewCell}" TargetType="TableViewCell">
    <Setter Property="Padding" Value="{StaticResource Md3TableViewCellPadding}" />
    <Setter Property="FontSize" Value="{StaticResource Md3BodyMediumSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource Md3FontFamilyPlain}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </ControlTheme>
</ResourceDictionary>
