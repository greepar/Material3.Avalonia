<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m3="using:Material3.Avalonia.Controls"
                    xmlns:m3p="using:Material3.Avalonia.Primitives">

  <!-- Top-level (menu bar) item: 40dp tall, 12dp horizontal padding, opens submenu below. -->
  <ControlTheme x:Key="Md3TopLevelMenuItem" TargetType="MenuItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceBrush}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="CornerRadius" Value="{StaticResource Md3CornerFull}" />
    <Setter Property="FontSize" Value="{StaticResource Md3LabelLargeSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource Md3FontFamilyPlain}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_LayoutRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <!-- state layer -->
            <Border Name="PART_StateLayer"
                    Background="{DynamicResource Md3OnSurfaceBrush}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <m3p:RippleHost RippleBrush="{DynamicResource Md3OnSurfaceBrush}"
                            RippleOpacity="{StaticResource Md3StatePressedOpacity}"
                            RippleClipRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter Name="PART_HeaderPresenter"
                              Content="{TemplateBinding Header}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"
                              Margin="{TemplateBinding Padding}" />
            <Popup Name="PART_Popup"
                   WindowManagerAddShadowHint="False"
                   MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                   IsLightDismissEnabled="True"
                   InheritsTransform="True"
                   IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                   Placement="BottomEdgeAlignedLeft"
                   OverlayInputPassThroughElement="{Binding $parent[Menu]}">
              <!-- Margin reserves space for the BoxShadow so it is not clipped by the popup bounds -->
              <Border Name="PART_PopupBorder"
                      m3p:Entrance.Animation="GrowDown"
                      RenderTransformOrigin="50%,0%"
                      Margin="10,8,10,14"
                      Background="{DynamicResource Md3SurfaceContainerBrush}"
                      CornerRadius="{StaticResource Md3CornerSmall}"
                      BoxShadow="{StaticResource Md3Elevation2}"
                      Padding="0,8"
                      MinWidth="112"
                      MaxWidth="280"
                      HorizontalAlignment="Stretch">
                <ScrollViewer Theme="{StaticResource MenuScrollViewer}">
                  <ItemsPresenter Name="PART_ItemsPresenter"
                                  ItemsPanel="{TemplateBinding ItemsPanel}"
                                  Grid.IsSharedSizeScope="True" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="RecognizesAccessKey" Value="True" />
    </Style>

    <Style Selector="^ /template/ Border#PART_StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{StaticResource Md3StateHoverOpacity}" />
    </Style>
    <Style Selector="^:selected /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{StaticResource Md3StateHoverOpacity}" />
    </Style>
    <Style Selector="^:open /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="{DynamicResource Md3SecondaryContainerBrush}" />
    </Style>
    <Style Selector="^:open">
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^:open /template/ Border#PART_StateLayer">
      <Setter Property="Background" Value="{DynamicResource Md3OnSecondaryContainerBrush}" />
    </Style>

    <!-- Listen on PART_LayoutRoot:pointerover so it does not trigger when a subitem is pressed. -->
    <Style Selector="^:pressed /template/ Border#PART_LayoutRoot:pointerover Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{StaticResource Md3StatePressedOpacity}" />
    </Style>

    <Style Selector="^:disabled /template/ ContentPresenter#PART_HeaderPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Md3OnSurfaceBrush}" />
      <Setter Property="Opacity" Value="{StaticResource Md3DisabledContentOpacity}" />
    </Style>
  </ControlTheme>

  <!-- Material 3 horizontal menu bar. -->
  <ControlTheme x:Key="{x:Type Menu}" TargetType="Menu">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="ItemContainerTheme" Value="{StaticResource Md3TopLevelMenuItem}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                HorizontalAlignment="Stretch"
                Padding="{TemplateBinding Padding}">
          <ItemsPresenter Name="PART_ItemsPresenter"
                          ItemsPanel="{TemplateBinding ItemsPanel}"
                          VerticalAlignment="Stretch"
                          KeyboardNavigation.TabNavigation="Continue" />
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type m3:Menu}"
                TargetType="m3:Menu"
                BasedOn="{StaticResource {x:Type Menu}}" />
</ResourceDictionary>
