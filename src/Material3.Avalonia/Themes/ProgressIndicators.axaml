<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m3="using:Material3.Avalonia.Controls">

  <!-- Material 3 circular progress indicator (self-drawn; rendering lives in
       CircularProgressIndicator.Render). The theme only supplies default colors and size. -->
  <ControlTheme x:Key="{x:Type m3:CircularProgressIndicator}" TargetType="m3:CircularProgressIndicator">
    <Setter Property="Foreground" Value="{DynamicResource Md3PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource Md3SecondaryContainerBrush}" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>

  <!-- Material 3 Expressive loading indicator (self-drawn morphing polygon; rendering
       lives in LoadingIndicator.Render). Geometry/motion spec ported from m3fx. -->
  <ControlTheme x:Key="{x:Type m3:LoadingIndicator}" TargetType="m3:LoadingIndicator">
    <Setter Property="Foreground" Value="{DynamicResource Md3PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource Md3PrimaryContainerBrush}" />
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />

    <Style Selector="^[Variant=Contained]">
      <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimaryContainerBrush}" />
    </Style>
  </ControlTheme>

  <!-- Material 3 Expressive wavy linear progress indicator (self-drawn).
       Height comes from MeasureOverride (2*Amplitude + StrokeWidth) so custom
       amplitudes are never clipped; MinHeight keeps the default touch metric. -->
  <ControlTheme x:Key="{x:Type m3:WavyProgressBar}" TargetType="m3:WavyProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Md3PrimaryBrush}" />
    <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainerHighestBrush}" />
    <Setter Property="MinHeight" Value="16" />
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </ControlTheme>
</ResourceDictionary>
