<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m3="using:Material3.Avalonia.Controls">

  <!-- Material 3 badge. API modeled after m3fx (https://github.com/Glavo/m3fx), Apache-2.0;
       implementation follows the Material 3 spec: small dot = 6dp Error circle;
       large = 16dp-high Error pill with an OnError label-small count. -->
  <ControlTheme x:Key="{x:Type m3:Badge}" TargetType="m3:Badge">
    <Setter Property="Background" Value="{DynamicResource Md3ErrorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md3OnErrorBrush}" />
    <Setter Property="FontSize" Value="{StaticResource Md3LabelSmallSize}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFamily" Value="{DynamicResource Md3FontFamilyPlain}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <!-- small dot form -->
          <Ellipse Name="PART_Dot"
                   Fill="{TemplateBinding Background}"
                   Width="6"
                   Height="6"
                   IsVisible="False" />
          <!-- large labelled form -->
          <Border Name="PART_Pill"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{StaticResource Md3CornerFull}"
                  Height="16"
                  MinWidth="16"
                  Padding="4,0">
            <TextBlock Name="PART_Label"
                       Text="{TemplateBinding DisplayText}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="{TemplateBinding FontWeight}"
                       FontFamily="{TemplateBinding FontFamily}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^[IsDotBadge=True] /template/ Ellipse#PART_Dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^[IsDotBadge=True] /template/ Border#PART_Pill">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>

  <!-- Badged box: content with a badge anchored at the top-right corner, shifted
       outward so the badge straddles the content edge. -->
  <ControlTheme x:Key="{x:Type m3:BadgedBox}" TargetType="m3:BadgedBox">
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel ClipToBounds="False">
          <ContentPresenter Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          <ContentPresenter Name="PART_BadgePresenter"
                            Content="{TemplateBinding Badge}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False">
            <ContentPresenter.RenderTransform>
              <TranslateTransform X="6" Y="-6" />
            </ContentPresenter.RenderTransform>
          </ContentPresenter>
        </Panel>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

  <!-- Material 3 avatar: PrimaryContainer tile with image fill or initial text.
       Width/Height/CornerRadius/FontSize are driven from Avatar.cs (Size/Variant). -->
  <ControlTheme x:Key="{x:Type m3:Avatar}" TargetType="m3:Avatar">
    <Setter Property="Background" Value="{DynamicResource Md3PrimaryContainerBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimaryContainerBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontFamily" Value="{DynamicResource Md3FontFamilyPlain}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Container"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                ClipToBounds="True">
          <Panel>
            <TextBlock Name="PART_Initial"
                       Text="{TemplateBinding DisplayInitial}"
                       Foreground="{TemplateBinding Foreground}"
                       FontSize="{TemplateBinding FontSize}"
                       FontWeight="{TemplateBinding FontWeight}"
                       FontFamily="{TemplateBinding FontFamily}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
            <Image Name="PART_Image"
                   Source="{TemplateBinding Source}"
                   Stretch="UniformToFill"
                   IsVisible="False" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:has-image /template/ Image#PART_Image">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:has-image /template/ TextBlock#PART_Initial">
      <Setter Property="IsVisible" Value="False" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
