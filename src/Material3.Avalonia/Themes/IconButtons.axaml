<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:m3="using:Material3.Avalonia.Controls"
                    xmlns:m3p="using:Material3.Avalonia.Primitives">

  <!-- Material 3 icon buttons. API modeled after m3fx (https://github.com/Glavo/m3fx),
       Apache-2.0; implementation follows the Material 3 spec: 40dp circular container,
       centered 24dp icon (supplied as Content), variant-driven colors, hover state
       layer and circular ripple. The outline (Outlined variant) is drawn by a separate
       overlay border so its disabled opacity does not dim the icon. -->
  <ControlTheme x:Key="{x:Type m3:IconButton}" TargetType="m3:IconButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Md3CornerFull}" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Container"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Panel>
              <!-- state layer -->
              <Border Name="PART_StateLayer"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Opacity="0"
                      IsHitTestVisible="False" />
              <m3p:RippleHost RippleBrush="{TemplateBinding Foreground}"
                              RippleOpacity="{StaticResource Md3StatePressedOpacity}"
                              RippleClipRadius="{TemplateBinding CornerRadius}" />
              <ContentPresenter Name="PART_ContentPresenter"
                                 Content="{TemplateBinding Content}"
                                 ContentTemplate="{TemplateBinding ContentTemplate}"
                                 Width="24"
                                 Height="24"
                                 HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </Border>
          <!-- outline overlay: independent opacity so the disabled border (12%) does not dim the icon -->
          <Border Name="PART_Outline"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  IsHitTestVisible="False" />
          <!-- focus ring -->
          <Border Name="PART_FocusRing"
                  BorderBrush="{DynamicResource Md3PrimaryBrush}"
                  BorderThickness="{StaticResource Md3FocusRingThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Margin="-3"
                  IsVisible="False"
                  IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#PART_Container">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#PART_StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{StaticResource Md3StateHoverOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- variants -->
    <Style Selector="^[Variant=Filled]">
      <Setter Property="Background" Value="{DynamicResource Md3PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimaryBrush}" />
    </Style>
    <Style Selector="^[Variant=Tonal]">
      <Setter Property="Background" Value="{DynamicResource Md3SecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSecondaryContainerBrush}" />
    </Style>
    <Style Selector="^[Variant=Outlined]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Md3OutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- disabled: 12% container/outline, 38% content -->
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Md3OnSurfaceBrush}" />
      <Setter Property="Opacity" Value="{StaticResource Md3DisabledContentOpacity}" />
    </Style>
    <Style Selector="^:disabled[Variant=Filled] /template/ Border#PART_Container,
                     ^:disabled[Variant=Tonal] /template/ Border#PART_Container">
      <Setter Property="Background" Value="{DynamicResource Md3OnSurfaceBrush}" />
      <Setter Property="Opacity" Value="{StaticResource Md3DisabledContainerOpacity}" />
    </Style>
    <Style Selector="^:disabled[Variant=Outlined] /template/ Border#PART_Outline">
      <Setter Property="BorderBrush" Value="{DynamicResource Md3OnSurfaceBrush}" />
      <Setter Property="Opacity" Value="{StaticResource Md3DisabledContainerOpacity}" />
    </Style>
  </ControlTheme>

  <!-- Icon toggle button: unselected matches IconButton per variant; selecting animates
       the container color (0.15s) and morphs the corner radius from full to 12dp (0.2s,
       M3 Expressive shape change). The visible container owns the transition so template
       bindings cannot skip the intermediate corner-radius frames on Browser. -->
  <ControlTheme x:Key="{x:Type m3:IconToggleButton}" TargetType="m3:IconToggleButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{StaticResource Md3CornerFull}" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="PART_Container"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <Panel>
              <Border Name="PART_StateLayer"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{TemplateBinding CornerRadius}"
                      Opacity="0"
                      IsHitTestVisible="False" />
              <m3p:RippleHost RippleBrush="{TemplateBinding Foreground}"
                              RippleOpacity="{StaticResource Md3StatePressedOpacity}"
                              RippleClipRadius="{TemplateBinding CornerRadius}" />
              <ContentPresenter Name="PART_ContentPresenter"
                                 Content="{TemplateBinding Content}"
                                 ContentTemplate="{TemplateBinding ContentTemplate}"
                                 Width="24"
                                 Height="24"
                                 HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Panel>
          </Border>
          <Border Name="PART_Outline"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  IsHitTestVisible="False" />
          <Border Name="PART_FocusRing"
                  BorderBrush="{DynamicResource Md3PrimaryBrush}"
                  BorderThickness="{StaticResource Md3FocusRingThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Margin="-3"
                  IsVisible="False"
                  IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>

    <Style Selector="^ /template/ Border#PART_Container">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.15" />
          <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.2" Easing="CubicEaseOut" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="^ /template/ Border#PART_StateLayer">
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
        </Transitions>
      </Setter>
    </Style>

    <Style Selector="^:pointerover /template/ Border#PART_StateLayer">
      <Setter Property="Opacity" Value="{StaticResource Md3StateHoverOpacity}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#PART_FocusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- selected: corner morphs full -> 12dp -->
    <Style Selector="^:checked">
      <Setter Property="CornerRadius" Value="{StaticResource Md3CornerMedium}" />
    </Style>

    <!-- Standard: transparent container; selected icon turns Primary -->
    <Style Selector="^:checked[Variant=Standard]">
      <Setter Property="Foreground" Value="{DynamicResource Md3PrimaryBrush}" />
    </Style>

    <!-- Filled: unselected SurfaceContainerHighest/Primary, selected Primary/OnPrimary -->
    <Style Selector="^[Variant=Filled]">
      <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainerHighestBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3PrimaryBrush}" />
    </Style>
    <Style Selector="^:checked[Variant=Filled]">
      <Setter Property="Background" Value="{DynamicResource Md3PrimaryBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnPrimaryBrush}" />
    </Style>

    <!-- Tonal: unselected SurfaceContainerHighest, selected SecondaryContainer -->
    <Style Selector="^[Variant=Tonal]">
      <Setter Property="Background" Value="{DynamicResource Md3SurfaceContainerHighestBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSurfaceVariantBrush}" />
    </Style>
    <Style Selector="^:checked[Variant=Tonal]">
      <Setter Property="Background" Value="{DynamicResource Md3SecondaryContainerBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3OnSecondaryContainerBrush}" />
    </Style>

    <!-- Outlined: outlined unselected, selected InverseSurface/InverseOnSurface -->
    <Style Selector="^[Variant=Outlined]">
      <Setter Property="BorderBrush" Value="{DynamicResource Md3OutlineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="^:checked[Variant=Outlined]">
      <Setter Property="Background" Value="{DynamicResource Md3InverseSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource Md3InverseOnSurfaceBrush}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- disabled -->
    <Style Selector="^:disabled">
      <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="TextElement.Foreground" Value="{DynamicResource Md3OnSurfaceBrush}" />
      <Setter Property="Opacity" Value="{StaticResource Md3DisabledContentOpacity}" />
    </Style>
    <Style Selector="^:disabled[Variant=Filled] /template/ Border#PART_Container,
                     ^:disabled[Variant=Tonal] /template/ Border#PART_Container,
                     ^:disabled:checked /template/ Border#PART_Container">
      <Setter Property="Background" Value="{DynamicResource Md3OnSurfaceBrush}" />
      <Setter Property="Opacity" Value="{StaticResource Md3DisabledContainerOpacity}" />
    </Style>
    <Style Selector="^:disabled[Variant=Outlined] /template/ Border#PART_Outline">
      <Setter Property="BorderBrush" Value="{DynamicResource Md3OnSurfaceBrush}" />
      <Setter Property="Opacity" Value="{StaticResource Md3DisabledContainerOpacity}" />
    </Style>
    <Style Selector="^:disabled[Variant=Standard] /template/ Border#PART_Container">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
