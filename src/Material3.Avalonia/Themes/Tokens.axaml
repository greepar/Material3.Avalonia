<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== Shape (corner radius scale) =====================
       Source: m3.material.io/styles/shape/corner-radius-scale (snapshot 2026-07-25) -->
  <CornerRadius x:Key="Md3CornerNone">0</CornerRadius>
  <CornerRadius x:Key="Md3CornerExtraSmall">4</CornerRadius>
  <CornerRadius x:Key="Md3CornerSmall">8</CornerRadius>
  <CornerRadius x:Key="Md3CornerMedium">12</CornerRadius>
  <CornerRadius x:Key="Md3CornerLarge">16</CornerRadius>
  <CornerRadius x:Key="Md3CornerLargeIncreased">20</CornerRadius>
  <CornerRadius x:Key="Md3CornerExtraLarge">28</CornerRadius>
  <CornerRadius x:Key="Md3CornerExtraLargeIncreased">32</CornerRadius>
  <CornerRadius x:Key="Md3CornerExtraExtraLarge">48</CornerRadius>
  <!-- "Full" for fixed-height components; value equals half of common 40dp height.
       Implementation token: Avalonia clamps radius to bounds so oversized value acts as fully rounded. -->
  <CornerRadius x:Key="Md3CornerFull">9999</CornerRadius>

  <!-- ===================== State layer opacities =====================
       Source: m3.material.io/foundations/interaction/states/state-layers (snapshot 2026-07-25) -->
  <x:Double x:Key="Md3StateHoverOpacity">0.08</x:Double>
  <x:Double x:Key="Md3StateFocusOpacity">0.10</x:Double>
  <x:Double x:Key="Md3StatePressedOpacity">0.10</x:Double>
  <x:Double x:Key="Md3StateDraggedOpacity">0.16</x:Double>
  <x:Double x:Key="Md3DisabledContentOpacity">0.38</x:Double>
  <x:Double x:Key="Md3DisabledContainerOpacity">0.12</x:Double>

  <!-- ===================== Elevation (shadow approximation) =====================
       Levels from m3.material.io/styles/elevation/tokens; BoxShadow parameters are
       implementation tokens visually calibrated for Avalonia/Skia. -->
  <!-- Level 0 keeps the same two-layer structure as levels 1-5 so that
       BoxShadowsTransition can interpolate pairwise (mismatched counts snap instead of fading). -->
  <BoxShadows x:Key="Md3Elevation0">0 0 0 0 #00000000, 0 0 0 0 #00000000</BoxShadows>
  <BoxShadows x:Key="Md3Elevation1">0 1 2 0 #4D000000, 0 1 3 1 #26000000</BoxShadows>
  <BoxShadows x:Key="Md3Elevation2">0 1 2 0 #4D000000, 0 2 6 2 #26000000</BoxShadows>
  <BoxShadows x:Key="Md3Elevation3">0 1 3 0 #4D000000, 0 4 8 3 #26000000</BoxShadows>
  <BoxShadows x:Key="Md3Elevation4">0 2 3 0 #4D000000, 0 6 10 4 #26000000</BoxShadows>
  <BoxShadows x:Key="Md3Elevation5">0 4 4 0 #4D000000, 0 8 12 6 #26000000</BoxShadows>

  <!-- ===================== Motion (compat easing/duration tokens) =====================
       Source: m3.material.io/styles/motion/overview/specs (snapshot 2026-07-25).
       Compat tween path; spring path lives in MaterialMotion (C#). -->
  <x:TimeSpan x:Key="Md3DurationShort1">0:0:0.05</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationShort2">0:0:0.1</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationShort3">0:0:0.15</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationShort4">0:0:0.2</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationMedium1">0:0:0.25</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationMedium2">0:0:0.3</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationMedium3">0:0:0.35</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationMedium4">0:0:0.4</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationLong1">0:0:0.45</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationLong2">0:0:0.5</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationLong3">0:0:0.55</x:TimeSpan>
  <x:TimeSpan x:Key="Md3DurationLong4">0:0:0.6</x:TimeSpan>

  <!-- ===================== Typography =====================
       Source: m3.material.io/styles/typography/type-scale-tokens (snapshot 2026-07-25).
       FontFamily is configurable; default falls back to platform sans. -->
  <FontFamily x:Key="Md3FontFamilyPlain">Roboto, "Segoe UI", "Helvetica Neue", "Noto Sans", "PingFang SC", "Microsoft YaHei", sans-serif</FontFamily>
  <FontFamily x:Key="Md3FontFamilyBrand">Roboto, "Segoe UI", "Helvetica Neue", "Noto Sans", "PingFang SC", "Microsoft YaHei", sans-serif</FontFamily>

  <x:Double x:Key="Md3DisplayLargeSize">57</x:Double>
  <x:Double x:Key="Md3DisplayLargeLineHeight">64</x:Double>
  <x:Double x:Key="Md3DisplayMediumSize">45</x:Double>
  <x:Double x:Key="Md3DisplayMediumLineHeight">52</x:Double>
  <x:Double x:Key="Md3DisplaySmallSize">36</x:Double>
  <x:Double x:Key="Md3DisplaySmallLineHeight">44</x:Double>
  <x:Double x:Key="Md3HeadlineLargeSize">32</x:Double>
  <x:Double x:Key="Md3HeadlineLargeLineHeight">40</x:Double>
  <x:Double x:Key="Md3HeadlineMediumSize">28</x:Double>
  <x:Double x:Key="Md3HeadlineMediumLineHeight">36</x:Double>
  <x:Double x:Key="Md3HeadlineSmallSize">24</x:Double>
  <x:Double x:Key="Md3HeadlineSmallLineHeight">32</x:Double>
  <x:Double x:Key="Md3TitleLargeSize">22</x:Double>
  <x:Double x:Key="Md3TitleLargeLineHeight">28</x:Double>
  <x:Double x:Key="Md3TitleMediumSize">16</x:Double>
  <x:Double x:Key="Md3TitleMediumLineHeight">24</x:Double>
  <x:Double x:Key="Md3TitleSmallSize">14</x:Double>
  <x:Double x:Key="Md3TitleSmallLineHeight">20</x:Double>
  <x:Double x:Key="Md3BodyLargeSize">16</x:Double>
  <x:Double x:Key="Md3BodyLargeLineHeight">24</x:Double>
  <x:Double x:Key="Md3BodyMediumSize">14</x:Double>
  <x:Double x:Key="Md3BodyMediumLineHeight">20</x:Double>
  <x:Double x:Key="Md3BodySmallSize">12</x:Double>
  <x:Double x:Key="Md3BodySmallLineHeight">16</x:Double>
  <x:Double x:Key="Md3LabelLargeSize">14</x:Double>
  <x:Double x:Key="Md3LabelLargeLineHeight">20</x:Double>
  <x:Double x:Key="Md3LabelMediumSize">12</x:Double>
  <x:Double x:Key="Md3LabelMediumLineHeight">16</x:Double>
  <x:Double x:Key="Md3LabelSmallSize">11</x:Double>
  <x:Double x:Key="Md3LabelSmallLineHeight">16</x:Double>

  <!-- ===================== Focus indicator =====================
       Implementation tokens for :focus-visible ring. -->
  <Thickness x:Key="Md3FocusRingThickness">2</Thickness>
  <x:Double x:Key="Md3FocusRingOffset">2</x:Double>

  <!-- ===================== Component metrics (implementation tokens) ===================== -->
  <x:Double x:Key="Md3ButtonHeight">40</x:Double>
  <Thickness x:Key="Md3ButtonPadding">24,0</Thickness>
  <x:Double x:Key="Md3IconButtonSize">40</x:Double>
  <x:Double x:Key="Md3MinTouchTarget">48</x:Double>
  <x:Double x:Key="Md3TextFieldHeight">56</x:Double>
  <Thickness x:Key="Md3TextFieldPadding">16,8</Thickness>
  <x:Double x:Key="Md3ListItemHeight">48</x:Double>
  <x:Double x:Key="Md3MenuItemHeight">48</x:Double>
</ResourceDictionary>
