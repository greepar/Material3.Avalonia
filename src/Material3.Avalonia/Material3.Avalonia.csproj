<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Material3.Avalonia</RootNamespace>
        <PackageId>Material3.Avalonia</PackageId>
        <Version>0.2.0-preview.1</Version>
        <Authors>greepar</Authors>
        <Description>Standalone Material Design 3 theme and control library for Avalonia 12.1.</Description>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/greepar/Material3.Avalonia</RepositoryUrl>
        <PackageProjectUrl>https://greepar.github.io/Material3.Avalonia/</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>avalonia;avaloniaui;material;material-design;material3;theme;controls;desktop;android;ios;wasm</PackageTags>
        <Copyright>Copyright © 2026 greepar</Copyright>
        <PackageReleaseNotes>First NuGet preview: net8.0+ support, documented Material controls, improved keyboard access, safer bindings and validated public properties.</PackageReleaseNotes>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <DebugType>portable</DebugType>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- AOT / trimming support: no reflection is used by the library;
             analyzers verify compatibility at build time. -->
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <!-- Material Symbols are generated from the official Google SVG package. -->
        <MaterialSymbolsSource>$(MSBuildProjectDirectory)\..\..\tools\generate-material-symbols.mjs</MaterialSymbolsSource>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
    </ItemGroup>

</Project>
